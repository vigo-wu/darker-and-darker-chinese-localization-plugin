{
  "manifest_version": 3,
  "name": "Dark and Darker Tracker 汉化",
  "version": "1.0.0",
  "description": "为 darkanddarkertracker.com 地图页面提供中文汉化",
  "permissions": ["storage"],
  "host_permissions": ["https://darkanddarkertracker.com/*"],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "DarkTrans 汉化",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://darkanddarkertracker.com/*"],
      "js": [
        "src/locales/category/mapLocations.js",
        "src/locales/category/containers.js",
        "src/locales/category/monsters.js",
        "src/locales/category/herbs.js",
        "src/locales/category/traps.js",
        "src/locales/category/loot.js",
        "src/locales/category/items.js",
        "src/locales/zh-CN.js",
        "src/content/translator.js",
        "src/content/index.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
