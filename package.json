{
  "name": "darktrans",
  "version": "1.0.0",
  "description": "Chrome extension to localize darkanddarkertracker.com/maps into Chinese",
  "private": true,
  "scripts": {
    "icons": "node scripts/generate-icons.js",
    "extract-strings": "node scripts/extract-ui-strings.js",
    "rebuild-dictionary": "node scripts/rebuild-dictionary.js",
    "build:dev": "node scripts/build.js --mode=dev",
    "build:prod": "node scripts/build.js --mode=prod",
    "dev": "node scripts/dev.js",
    "build": "node scripts/package.js",
    "package": "node scripts/package.js",
    "test:map-label-svg": "node scripts/test-map-label-svg.js",
    "postinstall": "node scripts/generate-icons.js"
  },
  "devDependencies": {
    "chokidar": "^4.0.3",
    "ws": "^8.18.3"
  },
  "keywords": [
    "chrome-extension",
    "dark-and-darker",
    "localization",
    "translation"
  ],
  "author": "",
  "license": "ISC"
}
